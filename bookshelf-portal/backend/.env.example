# ─── App ──────────────────────────────────────────────────────────────────────
APP_PASSWORD=changeme
APP_SESSION_SECRET=generate-a-long-random-string-here
SESSION_TTL_HOURS=8.0
MOCK_MODE=false
PORT=8788

# ─── Prowlarr ─────────────────────────────────────────────────────────────────
PROWLARR_BASE_URL=http://localhost:9696
PROWLARR_API_KEY=your-prowlarr-api-key

# ─── Torrent client ───────────────────────────────────────────────────────────
# Set to "rtorrent" or "qbittorrent"
TORRENT_CLIENT=rtorrent

# rTorrent (used when TORRENT_CLIENT=rtorrent)
RTORRENT_URL=http://localhost/xmlrpc
RTORRENT_USER=
RTORRENT_PASSWORD=
RTORRENT_DOWNLOAD_DIR=/downloads/books
RTORRENT_CATEGORY=books
RTORRENT_IMPORTED_CATEGORY=books-imported

# qBittorrent (used when TORRENT_CLIENT=qbittorrent)
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=adminadmin
QBITTORRENT_DOWNLOAD_DIR=/downloads/books
QBITTORRENT_CATEGORY=books
QBITTORRENT_IMPORTED_CATEGORY=books-imported

# ─── SABnzbd (usenet) ─────────────────────────────────────────────────────────
SABNZBD_BASE_URL=http://localhost:8080
SABNZBD_API_KEY=your-sabnzbd-api-key
SABNZBD_CATEGORY=books

# ─── Calibre ──────────────────────────────────────────────────────────────────
CALIBRE_LIBRARY_PATH=/path/to/calibre/library
# Docker image used to run calibredb when it is not installed on the host.
# Leave as-is unless you have a specific reason to change it.
CALIBRE_IMAGE=lscr.io/linuxserver/calibre:latest
CALIBREDB_BOOKS_DIR=/path/to/books

# ─── History ──────────────────────────────────────────────────────────────────
HISTORY_DB_PATH=/path/to/history.db

# ─── Bookshelf / Readarr (optional) ──────────────────────────────────────────
# Set BOOKSHELF_ENABLED=false to use Prowlarr search only (no Readarr required)
BOOKSHELF_ENABLED=false
BOOKSHELF_BASE_URL=http://localhost:8787
BOOKSHELF_API_KEY=your-bookshelf-api-key

# ─── Release filter tuning ────────────────────────────────────────────────────
# Comma-separated substrings matched case-insensitively against indexer names.
#
# FILTER_TRUSTED_INDEXERS — releases from matching indexers skip the 512 KB
# minimum-size check.  Useful for curated trackers (e.g. MyAnonamouse) where
# legitimately short books exist.
FILTER_TRUSTED_INDEXERS=myanon,mam

# FILTER_PREFERRED_INDEXERS — releases from matching indexers receive a score
# bonus, pushing them toward the top of results.
FILTER_PREFERRED_INDEXERS=myanon,mam
